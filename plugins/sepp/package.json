{
  "name": "sepp",
  "version": "0.1.0",
  "private": true,
  "description": "Caido plugin: right-click a request, hand it to the local pi coding agent",
  "type": "module",
  "scripts": {
    "build:backend": "vite build --config vite.backend.config.mts",
    "build:frontend": "vite build --config vite.frontend.config.mts",
    "build": "npm run build:backend && npm run build:frontend",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "pack": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@caido/sdk-backend": "0.41.0",
    "@caido/sdk-frontend": "0.41.0",
    "@types/node": "^20.0.0",
    "jszip": "3.10.1",
    "typescript": "5.4.3",
    "vite": "5.2.7"
  }
}
